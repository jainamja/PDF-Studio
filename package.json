{
  "name": "pdf-studio",
  "homepage": "https://pdf-topaz-chi.vercel.app",
  "version": "1.0.0",
  "description": "PDF Studio - Professional Desktop PDF Editor",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-dev.mjs",
    "dev": "vite",
    "dev:electron": "electron .",
    "copy:assets": "node scripts/copy-pdfjs-assets.mjs",
    "build": "node scripts/copy-pdfjs-assets.mjs && vite build",
    "deploy": "npm run build && gh-pages -d dist --dotfiles --nojekyll",
    "preview": "vite preview",
    "test": "node scripts/selftest.mjs",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "pdf",
    "editor",
    "electron",
    "react"
  ],
  "author": "PDF Studio Team",
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.8.0",
    "electron-builder": "^26.7.0",
    "gh-pages": "^6.3.0",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "com.pdfstudio.app",
    "productName": "PDF Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
